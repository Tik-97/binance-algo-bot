BINANCE_API_KEY=your_live_api_key
BINANCE_API_SECRET=your_live_api_secret

BINANCE_REST_BASE_URL=https://fapi.binance.com
BINANCE_WS_STREAM_BASE_URL=wss://fstream.binance.com
TRADING_MODE=live

TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_default_chat_id
# TELEGRAM_EVENTS_CHAT_ID=your_events_chat_id
# TELEGRAM_REPORTS_CHAT_ID=your_reports_chat_id

SYMBOL=ETHUSDT
LEVERAGE=10
ORDER_MARGIN_SAFETY_BUFFER=0.985

ENABLED_STRATEGIES=short_t287,long_t14,long_f21
POSITION_SIZE_MODE=full_balance
# POSITION_SIZE_MODE=fixed_usd
# NOTIONAL_USD_PER_TRADE=50.0

SESSION_START_HOUR_UTC=13
SESSION_END_HOUR_UTC=16
SHORT_T287_SESSION_START_UTC=13
SHORT_T287_SESSION_END_UTC=16
LONG_T14_SESSION_START_UTC=0
LONG_T14_SESSION_END_UTC=24
LONG_F21_SESSION_START_UTC=0
